        {
          "name": "nav",
          "type": "DOUBLE",
          "nullable": true,
          "primary_key": false,
          "description": "Net asset value per unit, in rupees. Total-return by construction \u2014 it absorbs distributions \u2014 so the ratio of two NAVs is the return between those dates, with no dividend adjustment needed. NULL where the source published a value that could not be read as a number; the row is kept so that fact stays visible.",
          "source_field": "mfapi data[].nav"
        },
